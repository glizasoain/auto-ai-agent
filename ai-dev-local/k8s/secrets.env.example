GH_TOKEN=ghp_********************
# Optional: fallback repo if the Jira ticket description does not include one
REPO_URL=https://github.com/your-org/your-repo.git
JIRA_BASE=https://yourco.atlassian.net
JIRA_EMAIL=cursor-bot@yourco.com
JIRA_TOKEN=***************
# Optional overrides for Jira search behavior
# JIRA_JQL=status = "Ready for Development" AND labels = AI_ALLOWED ORDER BY updated DESC
# JIRA_MAX_RESULTS=5
OPENAI_API_KEY=sk-************************
AIDER_MODEL=openai/gpt-4o-mini
# Optional: run tests or other commands after Aider completes (e.g., "npm test")
POST_RUN_COMMAND=
# MySQL settings for the agent state store
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cursor
MYSQL_PASSWORD=cursor-secret
MYSQL_DB=agent

# S3-compatible storage (MinIO locally) for persistent Aider transcripts
AWS_ACCESS_KEY_ID=aideradmin
AWS_SECRET_ACCESS_KEY=aidersecret
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:9000
AIDER_SESSION_BUCKET=aider-sessions
AIDER_SESSION_PREFIX=sessions/

# NOTE: ISSUE_KEY and ISSUE_SUMMARY are injected dynamically by the Prefect flow.

